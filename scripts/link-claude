#!/bin/sh
set -eu

usage() {
  printf '%s\n' "Usage: $0 [--force] [profile-dir...]"
  printf '%s\n' "Links repo-tracked Claude config into ~/.claude."
  printf '%s\n' "Each profile-dir (an extra CLAUDE_CONFIG_DIR) shares settings.json and the skills."
}

die() {
  printf '%s\n' "$1" >&2
  exit 1
}

FORCE=0
PROFILES=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --force|-f)
      FORCE=1
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    -*)
      usage >&2
      die "Unknown argument: $1"
      ;;
    *)
      PROFILES="$PROFILES $1"
      ;;
  esac
  shift
done

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
SOURCE_DIR="$REPO_ROOT/custom/claude"
TIMESTAMP="$(date '+%Y%m%d%H%M%S')"

[ -d "$SOURCE_DIR" ] || die "Missing Claude config: $SOURCE_DIR"

for profile in $PROFILES; do
  [ -d "$profile" ] || die "Missing profile dir: $profile"
  [ ! -L "$profile/skills" ] || die "Not a separate profile: $profile/skills is a symlink."
done

mkdir -p "$HOME/.claude"

link_path() {
  src="$1"
  dest="$2"

  [ -e "$src" ] || die "Missing source: $src"

  if [ -L "$dest" ]; then
    rm "$dest"
  elif [ -e "$dest" ]; then
    if [ "$FORCE" -ne 1 ]; then
      die "Refusing to replace non-symlink: $dest. Re-run with --force to move it aside."
    fi

    backup="$dest.bak.$TIMESTAMP"
    mv "$dest" "$backup"
    printf '%s\n' "Moved $dest to $backup"
  fi

  ln -s "$src" "$dest"
  printf '%s\n' "Linked $dest -> $src"
}

link_path "$SOURCE_DIR/settings.json" "$HOME/.claude/settings.json"
link_path "$SOURCE_DIR/commands" "$HOME/.claude/commands"

if [ -d "$SOURCE_DIR/hooks" ]; then
  link_path "$SOURCE_DIR/hooks" "$HOME/.claude/hooks"
fi

if [ -d "$SOURCE_DIR/skills" ]; then
  link_path "$SOURCE_DIR/skills" "$HOME/.claude/skills"
fi

for profile in $PROFILES; do
  link_path "$SOURCE_DIR/settings.json" "$profile/settings.json"

  # Link skills one by one: Claude Code syncs claude.ai skills into skills/synced
  # per account, so the directory itself has to stay the profile's own.
  mkdir -p "$profile/skills"
  for skill in "$SOURCE_DIR"/skills/*/; do
    skill="${skill%/}"
    [ -f "$skill/SKILL.md" ] || continue
    link_path "$skill" "$profile/skills/${skill##*/}"
  done
done

printf '%s\n' "Claude config linked."
