#!/bin/sh
set -eu

usage() {
  printf '%s\n' "Usage: $0 [--force]"
  printf '%s\n' "Links repo-tracked lazygit config into ~/.config/lazygit."
}

die() {
  printf '%s\n' "$1" >&2
  exit 1
}

FORCE=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --force|-f)
      FORCE=1
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "Unknown argument: $1"
      ;;
  esac
  shift
done

SCRIPT_DIR="$(CDPATH= cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)"
SOURCE_DIR="$REPO_ROOT/custom/lazygit"
TARGET_DIR="$HOME/.config/lazygit"
TIMESTAMP="$(date '+%Y%m%d%H%M%S')"

[ -d "$SOURCE_DIR" ] || die "Missing lazygit config: $SOURCE_DIR"

mkdir -p "$TARGET_DIR"

link_path() {
  src="$1"
  dest="$2"

  [ -e "$src" ] || die "Missing source: $src"

  if [ -L "$dest" ]; then
    rm "$dest"
  elif [ -e "$dest" ]; then
    if [ "$FORCE" -ne 1 ]; then
      die "Refusing to replace non-symlink: $dest. Re-run with --force to move it aside."
    fi

    backup="$dest.bak.$TIMESTAMP"
    mv "$dest" "$backup"
    printf '%s\n' "Moved $dest to $backup"
  fi

  ln -s "$src" "$dest"
  printf '%s\n' "Linked $dest -> $src"
}

link_path "$SOURCE_DIR/config.yml" "$TARGET_DIR/config.yml"
# themes/ must be a real directory so it can hold the machine-local switch
# symlink alongside the repo-tracked theme files.
mkdir -p "$TARGET_DIR/themes"

for theme in "$SOURCE_DIR"/themes/*.yml; do
  link_path "$theme" "$TARGET_DIR/themes/$(basename "$theme")"
done

# btop.conf points color_theme at this symlink; the fish appearance handler flips
# it. Seed it here so a fresh machine has a theme before any prompt has run.
# config.fish points LG_CONFIG_FILE at this symlink; the appearance handler flips it
if [ ! -e "$TARGET_DIR/themes/current.yml" ]; then
  ln -s mocha.yml "$TARGET_DIR/themes/current.yml"
  printf '%s\n' "Seeded $TARGET_DIR/themes/current.yml -> mocha.yml"
fi

printf '%s\n' "lazygit config linked."
