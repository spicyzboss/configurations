#!/bin/sh
set -eu

usage() {
  printf '%s\n' "Usage: $0 [--force]"
  printf '%s\n' "Links repo-tracked Fish config into ~/.config/fish."
}

die() {
  printf '%s\n' "$1" >&2
  exit 1
}

FORCE=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --force|-f)
      FORCE=1
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "Unknown argument: $1"
      ;;
  esac
  shift
done

SCRIPT_DIR="$(CDPATH= cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)"
SOURCE_DIR="$REPO_ROOT/custom/fish"
TARGET_DIR="$HOME/.config/fish"
THEME_NAME="catppuccin-mocha"
# Themes come from the catppuccin/fish plugin (see fish_plugins), not this repo
THEME_FILE="$TARGET_DIR/themes/$THEME_NAME.theme"
TIMESTAMP="$(date '+%Y%m%d%H%M%S')"

[ -d "$SOURCE_DIR" ] || die "Missing Fish config: $SOURCE_DIR"

mkdir -p "$TARGET_DIR"

link_path() {
  src="$1"
  dest="$2"

  [ -e "$src" ] || die "Missing source: $src"

  if [ -L "$dest" ]; then
    rm "$dest"
  elif [ -e "$dest" ]; then
    if [ "$FORCE" -ne 1 ]; then
      die "Refusing to replace non-symlink: $dest. Re-run with --force to move it aside."
    fi

    backup="$dest.bak.$TIMESTAMP"
    mv "$dest" "$backup"
    printf '%s\n' "Moved $dest to $backup"
  fi

  ln -s "$src" "$dest"
  printf '%s\n' "Linked $dest -> $src"
}

link_path "$SOURCE_DIR/config.fish" "$TARGET_DIR/config.fish"
link_path "$SOURCE_DIR/functions" "$TARGET_DIR/functions"
link_path "$SOURCE_DIR/completions" "$TARGET_DIR/completions"

if [ ! -f "$THEME_FILE" ]; then
  printf '%s\n' "Theme $THEME_NAME not installed; run 'fisher update' to install it."
elif command -v fish >/dev/null 2>&1; then
  fish -c "fish_config theme choose $THEME_NAME" >/dev/null 2>/dev/null || die "Failed to apply Fish theme: $THEME_NAME"
  printf '%s\n' "Applied Fish theme: $THEME_NAME"
else
  printf '%s\n' "Fish is not installed yet; theme will apply when Fish is available."
fi

printf '%s\n' "Fish config linked."
