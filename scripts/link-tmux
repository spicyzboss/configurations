#!/bin/sh
set -eu

usage() {
  printf '%s\n' "Usage: $0 [--force]"
  printf '%s\n' "Links repo-tracked tmux config into ~/.config/tmux."
}

die() {
  printf '%s\n' "$1" >&2
  exit 1
}

FORCE=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --force|-f)
      FORCE=1
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "Unknown argument: $1"
      ;;
  esac
  shift
done

SCRIPT_DIR="$(CDPATH= cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd "$SCRIPT_DIR/.." && pwd)"
SOURCE_DIR="$REPO_ROOT/custom/tmux"
TARGET_DIR="$HOME/.config/tmux"
TIMESTAMP="$(date '+%Y%m%d%H%M%S')"

[ -d "$SOURCE_DIR" ] || die "Missing tmux config: $SOURCE_DIR"

mkdir -p "$TARGET_DIR"

link_path() {
  src="$1"
  dest="$2"

  [ -e "$src" ] || die "Missing source: $src"

  if [ -L "$dest" ]; then
    rm "$dest"
  elif [ -e "$dest" ]; then
    if [ "$FORCE" -ne 1 ]; then
      die "Refusing to replace non-symlink: $dest. Re-run with --force to move it aside."
    fi

    backup="$dest.bak.$TIMESTAMP"
    mv "$dest" "$backup"
    printf '%s\n' "Moved $dest to $backup"
  fi

  ln -s "$src" "$dest"
  printf '%s\n' "Linked $dest -> $src"
}

link_path "$SOURCE_DIR/tmux.conf" "$TARGET_DIR/tmux.conf"
link_path "$SOURCE_DIR/flavor-mocha.conf" "$TARGET_DIR/flavor-mocha.conf"
link_path "$SOURCE_DIR/flavor-latte.conf" "$TARGET_DIR/flavor-latte.conf"

# tmux.conf sources this symlink for the catppuccin flavor; the fish appearance
# handler flips it. Seed it here so a fresh machine has a theme before any
# prompt has run.
if [ ! -e "$TARGET_DIR/flavor.conf" ]; then
  ln -s flavor-mocha.conf "$TARGET_DIR/flavor.conf"
  printf '%s\n' "Seeded $TARGET_DIR/flavor.conf -> flavor-mocha.conf"
fi

printf '%s\n' "tmux config linked."
