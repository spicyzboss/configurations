{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787/w/claude",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "ENABLE_TOOL_SEARCH": "auto",
    "_CLAUDE_CODE_ASSUME_FIRST_PARTY_BASE_URL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.npm/**)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Application Support/**/metamask*/**)",
      "Read(~/Library/Application Support/**/electrum*/**)",
      "Read(~/Library/Application Support/**/exodus*/**)",
      "Read(~/Library/Application Support/**/phantom*/**)",
      "Read(~/Library/Application Support/**/solflare*/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "skillOverrides": {
    "impeccable": "off"
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/spicyz/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/spicyz/.nix-profile/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/spicyz/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/spicyz/.nix-profile/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/spicyz/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/spicyz/.nix-profile/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/spicyz/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/spicyz/.nix-profile/bin/node'",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.nix-profile/bin/node' '/Users/spicyz/.caveman/cli/bin/caveman' shrink-hook",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/spicyz/.local/share/caveman-blocks/bin/caveman-blocks hook --harness claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/spicyz/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/spicyz/.nix-profile/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/spicyz/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/spicyz/.nix-profile/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/spicyz/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/spicyz/.nix-profile/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/spicyz/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/spicyz/.nix-profile/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/spicyz/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/spicyz/.nix-profile/bin/node'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/spicyz/.caveman/bin/caveman-proxy' native-hook claude --adapter '/Users/spicyz/.caveman/cli/lib/node_modules/@caveman-ai/cli/dist/native-hook-fast.js' --node '/Users/spicyz/.nix-profile/bin/node'",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "ccx@ccxai": true,
    "exa@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": false,
    "pstack@cursor-plugins": true
  },
  "extraKnownMarketplaces": {
    "ccxai": {
      "source": {
        "source": "github",
        "repo": "boss-spicyz100x/ccxai"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      }
    }
  },
  "feedbackDrafts": "notify",
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "autoCompactWindow": 1000000,
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "idleCompaction": false,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
