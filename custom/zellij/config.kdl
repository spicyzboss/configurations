// Session: plain `zellij` attaches to this one workspace instead of creating a
// randomly named session each time.
session_name "main"
attach_to_session true

// Theme: theme_dark/theme_light apply when the terminal answers the palette
// query (CSI 2031 / DSR 997); `theme` is the fallback when it does not.
theme "catppuccin-mocha"
theme_dark "catppuccin-mocha"
theme_light "catppuccin-latte"

// Only what differs from zellij's defaults, so this file stays readable.
default_layout "compact"     // default "default"
scroll_buffer_size 100000    // default 10000
copy_on_select false         // default true
show_release_notes false     // default true

ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

// Prefix: C-a (tmux mode), mirroring ~/.config/tmux/tmux.conf
keybinds {
    unbind "Ctrl b"

    shared_except "tmux" "locked" {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }

    tmux {
        // Send a literal C-a through to the running program
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }

        // Vim-style pane resizing, sticky so it repeats
        bind "H" { Resize "Increase Left"; }
        bind "J" { Resize "Increase Down"; }
        bind "K" { Resize "Increase Up"; }
        bind "L" { Resize "Increase Right"; }
    }
}
