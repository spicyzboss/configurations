// Theme
// Plain `zellij` attaches to this session instead of creating a randomly named
// one each time, so every window lands in the same workspace.
session_name "main"
attach_to_session true

// Fallback for terminals that do not answer the palette query (CSI 2031 / DSR 997);
// where they do, theme_dark/theme_light take over.
theme "catppuccin-mocha"
theme_dark "catppuccin-mocha"
theme_light "catppuccin-latte"

// General
default_layout "compact"
mouse_mode true
scroll_buffer_size 100000
copy_on_select false
styled_underlines true
show_release_notes false

ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

// Prefix: C-a (tmux mode), mirroring ~/.config/tmux/tmux.conf
keybinds {
    unbind "Ctrl b"

    shared_except "tmux" "locked" {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }

    tmux {
        // Send a literal C-a through to the running program
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }

        // Vim-style pane resizing, sticky so it repeats
        bind "H" { Resize "Increase Left"; }
        bind "J" { Resize "Increase Down"; }
        bind "K" { Resize "Increase Up"; }
        bind "L" { Resize "Increase Right"; }
    }
}
